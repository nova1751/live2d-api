{
  "name": "live2dapi-noa",
  "version": "2.9.11",
  "packageManager": "pnpm@10.33.0",
  "description": "面向网页的 Live2D 播放器和模型图鉴，支持自定义 Cubism 2–5 模型、点击互动与全屏预览。",
  "main": "./widget.mjs",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "demo": "pnpm run build && node scripts/vercel-static.mts && esbuild --servedir=public --serve=127.0.0.1:8803",
    "dev": "node scripts/build.mts --dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "build": "npm run typecheck && tsc -p tsconfig.types.json && node scripts/build.mts",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run build",
    "test:browser": "node test/browser.mts"
  },
  "author": "nova1751",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nova1751/live2d-api.git"
  },
  "keywords": [
    "live2d",
    "typescript",
    "cubism",
    "webgl",
    "widget"
  ],
  "bugs": {
    "url": "https://github.com/nova1751/live2d-api/issues"
  },
  "homepage": "https://nova1751.github.io/live2d-api/",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.25.12",
    "live2d-web": "0.9.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  },
  "types": "./widget.d.mts",
  "exports": {
    ".": {
      "types": "./widget.d.mts",
      "default": "./widget.mjs"
    },
    "./*": "./*"
  },
  "files": [
    "widget.mjs",
    "girls-frontline.mjs",
    "collections.mjs",
    "latest.mjs",
    "widget.d.mts",
    "library/catalog.d.ts",
    "autoload.js",
    "jsdelivr/",
    "npm/",
    "css/",
    "modern/",
    "waifu-tips.json",
    "live2d.min.js",
    "asteroids.js",
    "waifu-tips.en.json",
    "docs/en/README.md",
    "README.md"
  ],
  "jsdelivr": "autoload.js",
  "unpkg": "autoload.js"
}
