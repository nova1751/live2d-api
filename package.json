{
  "name": "live2dapi-noa",
  "version": "2.3.3",
  "packageManager": "pnpm@10.33.0",
  "description": "nova1751 的少女前线 Live2D 网页组件与历史加载器",
  "main": "./widget.mjs",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node scripts/build.mts --dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "build": "npm run typecheck && tsc -p tsconfig.types.json && node scripts/build.mts",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run build",
    "test:browser": "node test/browser.mts"
  },
  "author": "nova1751",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nova1751/live2d-api.git"
  },
  "keywords": [
    "live2d",
    "model",
    "api"
  ],
  "bugs": {
    "url": "https://github.com/nova1751/live2d-api/issues"
  },
  "homepage": "https://github.com/nova1751/live2d-api#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.25.12",
    "live2d-web": "0.9.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  },
  "types": "./widget.d.mts",
  "exports": {
    ".": {
      "types": "./widget.d.mts",
      "default": "./widget.mjs"
    },
    "./*": "./*"
  },
  "files": [
    "widget.mjs",
    "girls-frontline.mjs",
    "widget.d.mts",
    "library/catalog.d.ts",
    "autoload.js",
    "jsdelivr/",
    "npm/",
    "css/",
    "modern/",
    "waifu-tips.json",
    "live2d.min.js",
    "asteroids.js"
  ],
  "jsdelivr": "autoload.js",
  "unpkg": "autoload.js"
}
