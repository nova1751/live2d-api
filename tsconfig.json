{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "ES2022.Error",
      "DOM"
    ],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/vendor"
  ]
}
